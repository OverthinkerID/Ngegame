{
  "name": "@ngegame/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-tests/tests/*.test.js"
  },
  "dependencies": {
    "@ngegame/shared": "*",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^35.0.0"
  }
}
